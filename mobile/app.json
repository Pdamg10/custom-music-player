{
  "expo": {
    "name": "Custom Music Player",
    "slug": "custom-music-player-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "custommusicplayer",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050508"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
